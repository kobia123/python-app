apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: python-app
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/kobia123/python-app.git
    targetRevision: master
    path: k8s/charts/python-app
    helm:
      values: |
        replicaCount: 1

        image:
          repository: kobia123/python-app
          pullPolicy: IfNotPresent
          tag: v2

        imagePullSecrets: []
        nameOverride: ""
        fullnameOverride: ""

        podAnnotations: {}
        podLabels: {}

        serviceAccount:
          create: false
          automount: true
          annotations: {}
          name: ""

        podSecurityContext: {}
        securityContext: {}

        service:
          type: ClusterIP
          port: 5000

        ingress:
          enabled: true
          className: "nginx"
          annotations: {}
          hosts:
            - host: localhost
              paths:
                - path: /api/v1/info
                  pathType: Prefix
                - path: /api/v1/Healthz
                  pathType: Prefix
          tls: []

        httpRoute:
          enabled: false

        resources:
          requests:
            cpu: 50m
            memory: 50M

        livenessProbe:
          httpGet:
            path: /api/v1/Healthz
            port: http

        readinessProbe:
          httpGet:
            path: /api/v1/Healthz
            port: http

        autoscaling:
          enabled: false
          minReplicas: 1
          maxReplicas: 100
          targetCPUUtilizationPercentage: 80

        volumes: []
        volumeMounts: []

        nodeSelector: {}
        tolerations: []
        affinity: {}

  destination:
    server: https://kubernetes.default.svc
    namespace: default

  syncPolicy:
    automated: {}
